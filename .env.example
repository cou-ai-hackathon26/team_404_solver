# =====================================================================
#  MediConnect settings
# =====================================================================
#
#  EMAIL (verification codes): fill in ONLY these two lines, save, restart (npm start).
#    SMTP_USER = the Gmail address the codes are sent from
#    SMTP_PASS = that account's 16-letter Google App Password (NOT your normal password)
#      1) Turn on 2-Step Verification: https://myaccount.google.com/signinoptions/twosv
#      2) Create an App Password:      https://myaccount.google.com/apppasswords
#      3) Paste the 16 letters below (spaces are fine, they are removed).
#  Then run "npm run mailtest" to send yourself a test email.
#
SMTP_USER=your-email@gmail.com
SMTP_PASS=PASTE_16_LETTER_APP_PASSWORD_HERE

# ---------------------------------------------------------------------
#  Everything below already works as it is. No need to change anything.
# ---------------------------------------------------------------------

# Mail server. Empty = Gmail (smtp.gmail.com, port 465). If your network blocks 465 the app switches to 587 by itself.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
# Sender name shown in the inbox. Empty = "MediConnect <SMTP_USER>".
MAIL_FROM=

PORT=3000
NODE_ENV=development

# Long random string used to sign sessions and hash OTP codes.
SESSION_SECRET=change-me-to-a-long-random-string

# Session idle timeout in minutes (rolling).
SESSION_TIMEOUT_MINUTES=30

# ---- SMS (phone verification for medical shops and ambulances) ----
# console = print the code in the terminal. bulksmsbd = bulksmsbd.net (Bangladesh). twilio = Twilio.
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# While SMS is in console mode, pharmacy and ambulance codes are ALSO emailed (true/false).
SMS_EMAIL_COPY=true

# Show the code on the verification page only when it could not be emailed (development only).
DEV_SHOW_OTP=false

# ---- OTP and login policy ----
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Default number of hours a doctor's approved access to records lasts.
ACCESS_GRANT_HOURS=48

# Database file (SQLite, created automatically)
DB_FILE=data/mediconnect.db

# Time zone used for schedules, slots and reminders.
TZ=Asia/Dhaka

# ---- Health Assistant chatbot (optional) ----
# With a key, the assistant uses Claude to write answers from your own records.
# Without a key it still works, using built-in rule-based answers.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
