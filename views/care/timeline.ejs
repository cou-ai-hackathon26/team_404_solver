<%- include('../partials/top') %>
<% const cap = (d) => d[0].toUpperCase() + d.slice(1); const sc = access.scopes; %>
<div class="page-h"><div><h1><%= access.self ? 'My shared timeline' : patient.full_name + "'s timeline" %></h1>
  <p><%= patient.patient_code || '' %><%= patient.blood_group ? ' · Blood ' + patient.blood_group : '' %><%= patient.emergency_contact ? ' · Emergency contact ' + patient.emergency_contact : '' %></p></div>
  <div class="row" style="gap:8px">
    <%- access.self ? pill('You', 'blue') : pill(access.canAct ? 'Caregiver · can act' : 'Caregiver · view only', access.canAct ? 'green' : 'amber') %>
    <% if (!access.self && patient.phone) { %><a class="btn ghost sm" href="tel:<%= patient.phone %>"><%- icon('phone', 14) %> Call <%= patient.full_name.split(' ')[0] %></a><% } %>
    <a class="btn ghost sm" href="tel:999" style="color:#b91c1c"><%- icon('ambulance', 14) %> 999</a>
    <a class="btn ghost sm" href="/care"><%= user.role === 'caregiver' ? 'Care dashboard' : 'Caregivers' %></a></div></div>

<% if (!access.self) { %>
  <div class="alert info"><b>You are viewing as <%= user.full_name %></b>, an approved caregiver. <%= patient.full_name %> shares: <b><%= [sc.reminders && 'medicine reminders', sc.vitals && 'vitals', sc.reports && 'reports'].filter(Boolean).join(', ') %></b>. Everything you see and do is recorded in their audit log<%= access.canAct ? ' and marked “by ' + user.full_name + '” on the timeline' : '' %>.</div>
  <% if (newCount) { %><div class="alert success"><%- icon('sparkles', 16) %> <b><%= newCount %> new update<%= newCount > 1 ? 's' : '' %></b> since your last visit (<%= ago(since) %>). New items are marked <b>NEW</b> below.</div><% } %>
<% } %>

<% if (alerts.length) { %>
<section class="card mt-s" style="border:2px solid #ef4444"><div class="card-h"><h2>Medicine safety alert</h2><%- pill('Ask the doctor', 'red') %></div>
  <% for (const c of alerts) { %><div class="note blue mt-s"><%- icon('shield', 18) %><div><b><%= c.drugs.map(cap).join(' + ') %></b>: <%= c.why %>
    <div class="small muted"><%= c.records.map(r => cap(r.generic) + ' ' + r.source).join(' · ') %></div></div></div><% } %>
  <p class="small muted mt-s">The records and a drug-interaction rule disagree, so the Health AI will not give advice on these medicines. Contact the prescribing doctor or a pharmacist; do not stop or change a medicine without them.</p>
</section>
<% } %>

<div class="grid mt" style="grid-template-columns:1.4fr 1fr 1fr">
  <section class="card"><div class="card-h"><h2>Today's doses</h2><% if (sc.reminders) { %><%- pill(adherence.pct === null ? 'No data' : adherence.pct + '% taken (7 days)', adherence.pct !== null && adherence.pct < 80 ? 'amber' : 'green') %><% } %></div>
    <% if (!sc.reminders) { %><div class="empty small">Medicine reminders are not shared with you.</div><% } else if (!doses.length) { %><div class="empty small">No doses scheduled today.</div><% } %>
    <% for (const d of doses) { %>
      <div class="item"><span class="tile sm <%= d.status === 'taken' ? 't-teal' : d.status === 'skipped' || d.missed ? 't-red' : 't-orange' %>"><%- icon('pill', 16) %></span>
        <div class="grow"><b><%= fmtTime(d.due_at) %> · <%= d.medicine_name %></b><div class="meta"><%= d.dose || '' %> · <%= d.status === 'due' ? (d.missed ? 'missed' : 'due') : d.status %><%= d.by ? ' by ' + d.by : '' %></div></div>
        <% if (access.canAct && d.status !== 'taken') { %>
          <form method="post" action="/care/timeline/<%= patient.id %>/dose/<%= d.id %>/taken"><%- include('../partials/csrf') %><button class="btn sm">Taken</button></form>
          <% if (d.status === 'due') { %><form method="post" action="/care/timeline/<%= patient.id %>/dose/<%= d.id %>/skipped"><%- include('../partials/csrf') %><button class="btn ghost sm">Skip</button></form><% } %>
        <% } %></div>
    <% } %>
  </section>

  <section class="card"><div class="card-h"><h2>Latest vitals</h2><%- pill('Fixed medical limits') %></div>
    <% if (!sc.vitals) { %><div class="empty small">Vitals are not shared with you.</div><% } else { for (const [k, v] of Object.entries(vitals.kinds)) { %>
      <div class="item"><div class="grow"><b><%= v.name %></b><div class="meta"><%= v.last ? fmt(v.last) + ' ' + v.unit + ' · ' + v.trend.dir + ' · ' + ago(v.last.measured_at) : 'No readings' %></div></div><% if (v.status) { %><%- badge(v.status.level) %><% } %></div>
    <% } } %>
  </section>

  <div class="stack">
    <section class="card soft"><h2 style="margin-bottom:12px"><%= access.self ? 'Log a reading' : 'Log a reading for ' + patient.full_name.split(' ')[0] %></h2>
      <% if (!access.canAct || !sc.vitals) { %><div class="empty small">View only. <%= patient.full_name %> has not allowed you to log readings.</div><% } else { %>
      <form method="post" action="/care/timeline/<%= patient.id %>/reading"><%- include('../partials/csrf') %>
        <label class="f">Type<select name="kind" data-reading-kind><% for (const [k, v] of Object.entries(vitals.kinds)) { %><option value="<%= k %>"><%= v.name %></option><% } %></select></label>
        <div class="fgrid"><label class="f">Value <small data-unit></small><input name="value1" type="number" step="0.1" required></label>
          <label class="f" data-for="bp">Diastolic (bottom)<input name="value2" type="number" step="1"></label>
          <label class="f" data-for="sugar">When<select name="context"><option value="fasting">Fasting</option><option value="random">After meal / random</option></select></label></div>
        <label class="f">Measured at<input type="datetime-local" name="measured_at" value="<%= toLocalInput() %>"></label>
        <button class="btn block">Save reading</button></form><% } %>
    </section>
    <section class="card"><h2 style="margin-bottom:10px">Care note</h2>
      <form method="post" action="/care/timeline/<%= patient.id %>/note"><%- include('../partials/csrf') %>
        <label class="f"><textarea name="body" rows="3" maxlength="500" required placeholder="<%= access.self ? 'e.g. I will be out tonight, please remind me at 9 PM' : 'e.g. Gave the 9 PM dose after dinner; BP felt fine' %>"></textarea></label>
        <button class="btn ghost block">Add to timeline</button></form>
    </section>
  </div>
</div>

<section class="card mt"><div class="card-h"><h2>Shared timeline</h2>
  <div class="row" style="gap:6px">
    <% for (const [k, lbl, ok] of [['all','All',true],['dose','Reminders',sc.reminders],['vital','Vitals',sc.vitals],['report','Reports',sc.reports],['appointment','Appointments',true],['note','Notes',true]]) { if (!ok) continue; %>
      <a class="btn <%= filter === k ? '' : 'ghost' %> sm" href="?type=<%= k %>&days=<%= days %>"><%= lbl %></a><% } %>
    <% for (const n of [3,7,14,30]) { %><a class="btn <%= days === n ? '' : 'ghost' %> sm" href="?type=<%= filter %>&days=<%= n %>"><%= n %> days</a><% } %></div></div>
  <% if (!events.length) { %><div class="empty small">Nothing in this period.</div><% } %>
  <div class="timeline"><% let day = ''; for (const e of events) { const dd = fmtDate(e.at); if (dd !== day) { day = dd; %><div class="small muted mt-s" style="font-weight:700"><%= dd %></div><% } %>
    <div class="tl"><span class="dot <%= e.tone %>"></span><b style="font-size:14.5px"><%- icon(e.icon, 14) %> <%= e.title %><% if (since && e.at > since && e.byId !== user.id && e.at <= new Date().toISOString()) { %> <span class="badge green">NEW</span><% } %></b>
      <span class="small"><%= fmtTime(e.at) %> · <%= e.detail %><% if (e.by) { %> · <b>by <%= e.by %> (caregiver)</b><% } %><% if (e.link) { %> · <a href="<%= e.link %>" target="_blank">Open</a><% } %></span></div>
  <% } %></div>
</section>

<section class="card mt"><div class="card-h"><h2>Care team</h2><% if (access.self) { %><a class="btn ghost sm" href="/care">Manage</a><% } %></div>
  <div class="item"><%- avatar(patient.full_name, 'md', patient.id) %><div class="grow"><b><%= patient.full_name %></b><div class="meta">Patient · owns this timeline and decides who sees it</div></div></div>
  <% for (const c of caregivers) { %><div class="item"><%- avatar(c.full_name, 'md', c.caregiver_id) %><div class="grow"><b><%= c.full_name %></b><div class="meta"><%= c.relationship %> · <%= c.can_act ? 'can act' : 'view only' %> · sees <%= [c.share_reminders && 'reminders', c.share_vitals && 'vitals', c.share_reports && 'reports'].filter(Boolean).join(', ') %></div></div></div><% } %>
  <% if (!caregivers.length) { %><div class="empty small">No caregivers yet.</div><% } %>
</section>
<%- include('../partials/bottom') %>
