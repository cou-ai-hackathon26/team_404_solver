<%- include('../partials/top') %>
<% const shareText = (l) => [l.share_reminders && 'Medicine reminders', l.share_vitals && 'Vitals', l.share_reports && 'Reports'].filter(Boolean).join(' · ') || 'Nothing'; %>
<div class="page-h"><div><h1>Caregivers &amp; shared timeline</h1><p>Let a family member or carer follow your medicine reminders, vitals and reports on one shared timeline, and act for you if you allow it. You choose exactly what they see, and you can change or stop it at any time.</p></div>
  <a class="btn" href="/care/timeline/<%= user.id %>"><%- icon('activity', 16) %> My shared timeline</a></div>

<div class="grid g3" style="gap:14px">
  <div class="stat"><div class="top"><span class="tile sm t-pink"><%- icon('heart', 18) %></span></div><span class="lbl">My caregivers</span><span class="num"><%= mine.filter(m => m.status === 'active').length %></span><span class="sub"><%= mine.filter(m => m.status === 'pending').length %> invitation(s) waiting</span></div>
  <div class="stat"><div class="top"><span class="tile sm t-blue"><%- icon('users', 18) %></span></div><span class="lbl">People I care for</span><span class="num"><%= people.length %></span><span class="sub"><%= invites.length %> new invitation(s)</span></div>
  <div class="stat"><div class="top"><span class="tile sm t-teal"><%- icon('shield', 18) %></span></div><span class="lbl">Caregiver actions logged</span><span class="num"><%= log.length %></span><span class="sub">latest shown below</span></div>
</div>

<% if (invites.length) { %>
<section class="card mt" style="border:2px solid #f59e0b"><h2 style="margin-bottom:12px">Invitations for you</h2>
  <% for (const l of invites) { %>
    <div class="item"><%- avatar(l.full_name, 'md', l.patient_id) %><div class="grow"><b><%= l.full_name %></b> <span class="muted small">wants you as their caregiver (<%= l.relationship %>)</span>
      <div class="meta">Shares: <%= shareText(l) %> · <%= l.can_act ? 'you may act for them' : 'view only' %> · consent given <%= ago(l.consent_at) %></div></div>
      <form method="post" action="/care/links/<%= l.id %>/accept"><%- include('../partials/csrf') %><button class="btn sm">Accept</button></form>
      <form method="post" action="/care/links/<%= l.id %>/decline"><%- include('../partials/csrf') %><button class="btn ghost sm">Decline</button></form></div>
  <% } %>
</section>
<% } %>

<div class="grid g-main mt">
  <section class="card"><div class="card-h"><h2>My caregivers</h2><%- pill(mine.filter(m => m.status === 'active').length + ' active') %></div>
    <% if (!mine.length) { %><div class="empty small">You have not added a caregiver yet. Use the form to invite a family member or carer.</div><% } %>
    <% for (const l of mine) { %>
      <div class="card soft mt-s" style="padding:16px">
        <div class="row between"><div class="row"><%- avatar(l.full_name, 'md', l.caregiver_id) %><div><b><%= l.full_name %></b> <span class="muted small"><%= l.relationship %> · <%= l.email %></span>
          <div class="small"><%- badge(l.status === 'active' ? 'active' : 'pending', l.status === 'active' ? 'Active' : 'Waiting for them to accept') %> <%- l.caregiver_role === 'caregiver' ? pill('Caregiver account', 'purple') : '' %></div></div></div>
          <form method="post" action="/care/links/<%= l.id %>/revoke" data-confirm="End this caregiver's access now?"><%- include('../partials/csrf') %><button class="btn danger sm">Revoke</button></form></div>
        <div class="note blue mt-s"><%- icon('shield', 16) %><div><b>Consent receipt</b> · given <%= fmtDateTime(l.consent_at) %><br>Shared: <b><%= shareText(l) %></b> · <%= l.can_act ? 'Can act for you (mark doses, log readings)' : 'View only' %><%= l.last_viewed_at ? ' · Last viewed ' + ago(l.last_viewed_at) : '' %></div></div>
        <form method="post" action="/care/links/<%= l.id %>/permission" class="row mt-s" style="gap:14px"><%- include('../partials/csrf') %><input type="hidden" name="scopes" value="1">
          <label class="check"><input type="checkbox" name="share_reminders" value="1" <%= l.share_reminders ? 'checked' : '' %>> Reminders</label>
          <label class="check"><input type="checkbox" name="share_vitals" value="1" <%= l.share_vitals ? 'checked' : '' %>> Vitals</label>
          <label class="check"><input type="checkbox" name="share_reports" value="1" <%= l.share_reports ? 'checked' : '' %>> Reports</label>
          <label class="check"><input type="checkbox" name="can_act" value="1" <%= l.can_act ? 'checked' : '' %>> Can act for me</label>
          <button class="btn ghost sm">Save permissions</button></form>
      </div>
    <% } %>
  </section>

  <section class="card soft"><h2 style="margin-bottom:12px">Add a caregiver</h2>
    <form method="post" action="/care/invite"><%- include('../partials/csrf') %>
      <label class="f">Caregiver's MediConnect email<input type="email" name="email" required placeholder="e.g. caregiver@mediconnect.local"></label>
      <label class="f">Relationship<select name="relationship"><% for (const r of RELATIONSHIPS) { %><option><%= r %></option><% } %></select></label>
      <b class="small">What can they see?</b>
      <% for (const [k, label] of Object.entries(SCOPES)) { %><label class="check"><input type="checkbox" name="share_<%= k %>" value="1" checked> <%= label %></label><% } %>
      <b class="small mt-s" style="display:block">What can they do?</b>
      <label class="check"><input type="checkbox" name="can_act" value="1" checked> Act for me: mark doses taken/skipped and log vital readings</label>
      <label class="check mt-s" style="background:#fff7ed;padding:10px;border-radius:10px"><input type="checkbox" name="consent" value="yes" required> I consent to share the items ticked above with this person. I understand I can change or stop this at any time.</label>
      <button class="btn block mt-s">Send invitation</button>
      <p class="muted small mt-s">They need a free <b>Caregiver</b> (or Patient) account. Nothing is shared until they accept. Every view and action they take is recorded in your audit log and shown on your timeline.</p>
    </form>
  </section>
</div>

<div class="grid g2 mt">
  <section class="card"><div class="card-h"><h2>People I care for</h2><a class="btn ghost sm" href="/care?view=people">Care dashboard</a></div>
    <% if (!people.length) { %><div class="empty small">Nobody yet. When someone invites you and you accept, they appear here.</div><% } %>
    <% for (const l of people) { %>
      <div class="item"><%- avatar(l.full_name, 'md', l.patient_id) %><div class="grow"><b><%= l.full_name %></b> <span class="muted small">you are their <%= l.relationship.toLowerCase() %> caregiver</span>
        <div class="meta"><%- pill({ red: 'Needs attention', amber: 'Keep an eye on', green: 'All good' }[l.s.level], { red: 'red', amber: 'amber', green: 'green' }[l.s.level]) %> <%= l.can_act ? 'Can act' : 'View only' %></div></div>
        <a class="btn sm" href="/care/timeline/<%= l.patient_id %>">Open timeline</a>
        <form method="post" action="/care/links/<%= l.id %>/revoke" data-confirm="Stop being this person's caregiver?"><%- include('../partials/csrf') %><button class="btn ghost sm">Step down</button></form></div>
    <% } %>
  </section>
  <section class="card"><div class="card-h"><h2>What caregivers did</h2><%- pill('Audit log', 'gray') %></div>
    <% if (!log.length) { %><div class="empty small">No caregiver activity yet.</div><% } %>
    <div class="timeline"><% for (const l of log) { %><div class="tl"><span class="dot"></span><b style="font-size:14.5px"><%= l.full_name %> · <%= { 'caregiver.timeline_view': 'viewed your timeline', 'caregiver.dose_taken': 'marked a dose taken', 'caregiver.dose_skipped': 'marked a dose skipped', 'caregiver.reading_logged': 'logged a reading', 'caregiver.note': 'added a care note', 'caregiver.accepted': 'accepted your invitation', 'caregiver.document_view': 'opened a document', 'caregiver.revoked': 'ended the link', 'caregiver.declined': 'declined the invitation' }[l.action] || l.action %></b><span class="small"><%= fmtDateTime(l.created_at) %></span></div><% } %></div>
  </section>
</div>
<%- include('../partials/bottom') %>
