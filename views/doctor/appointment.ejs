<%- include('../partials/top') %>
<div class="page-h"><div class="row nowrap"><%- avatar(a.patient_name, 'lg', a.patient_id) %><div><h1><%= a.patient_name %></h1><p>Age <%= a.age ?? '—' %> · <%= a.gender || '—' %> · Blood group <%= a.blood_group || '—' %> · <%= a.patient_phone || '' %></p></div></div>
  <div class="row"><%- badge(a.status) %><a class="btn ghost sm" href="/doctor/patients?id=<%= a.patient_id %>">Records</a><% if (['confirmed','completed'].includes(a.status)) { %><a class="btn sm" href="/doctor/appointments/<%= a.id %>/prescribe"><%- icon('pen', 16) %>Write prescription</a><% } %></div></div>
<div class="grid g-main">
  <div class="stack">
    <section class="card"><h2>Consultation</h2>
      <div class="grid g2 mt" style="gap:12px">
        <div class="item" style="margin:0"><div><span class="muted small">Time</span><div><b><%= a.proposed_time ? friendly(a.proposed_time) : 'Not set' %></b></div></div></div>
        <div class="item" style="margin:0"><div><span class="muted small">Type</span><div><b><%= a.mode === 'online' ? 'Online' : 'In person' %> · <%= a.duration %> min</b></div></div></div></div>
      <div class="item mt-s"><div><span class="muted small">Reason</span><p style="color:var(--ink)"><%= entry ? entry.description : a.reason %></p></div></div>
      <% if (a.status === 'confirmed') { %>
        <form method="post" action="/doctor/appointments/<%= a.id %>/complete" class="mt"><%- include('../partials/csrf') %>
          <label class="f">Consultation notes (shared with the patient)<textarea name="notes" placeholder="Findings and advice"></textarea></label>
          <button class="btn">Complete and write prescription</button></form>
      <% } else if (['requested','reschedule_requested','proposed'].includes(a.status)) { %><a class="btn mt" href="/doctor/requests?id=<%= a.id %>">Propose a time</a><% } %>
      <% if (a.consultation_notes) { %><div class="note blue mt"><%- icon('pen', 18) %><span><b>Notes:</b> <%= a.consultation_notes %></span></div><% } %>
    </section>
    <section class="card"><h2 style="margin-bottom:12px">From this consultation</h2>
      <% if (!tests.length && !prescriptions.length) { %><div class="empty small">No prescription or tests yet.</div><% } %>
      <% for (const t of tests) { %><span class="chip" style="margin:0 6px 6px 0;font-size:13px"><%- icon('flask', 14) %><%= t.name %> · <%= label(t.status) %></span><% } %>
      <% for (const p of prescriptions) { %><div class="item mt-s"><span class="tile sm t-blue"><%- icon('file', 18) %></span><div class="grow"><b>Prescription #<%= p.id %></b><div class="meta">Signed <%= friendly(p.created_at) %></div></div><%- pill('Verified', 'green') %></div><% } %>
    </section>
  </div>
  <div class="stack">
    <section class="card" id="messages"><h2 style="margin-bottom:14px">Messages and history</h2>
      <div class="timeline"><% for (const m of messages) { %><div class="tl"><span class="dot <%= m.kind === 'message' ? 'purple' : m.sender_id === user.id ? 'blue' : 'orange' %>"></span><b style="font-size:14.5px"><%= m.kind === 'message' ? m.full_name + ': ' : '' %><%= m.body %></b><span class="small"><%= friendly(m.created_at) %></span></div><% } %></div>
      <form method="post" action="/doctor/appointments/<%= a.id %>/message" class="mt"><%- include('../partials/csrf') %><textarea name="body" required placeholder="Message the patient" style="min-height:70px"></textarea><button class="btn sm mt-s">Send</button></form>
    </section>
    <section class="card"><h2 style="margin-bottom:12px">Health status</h2>
      <% if (!vitals) { %><div class="note blue"><%- icon('shield', 18) %> Shared readings appear after the patient approves your access.</div>
      <% } else { for (const k of Object.values(vitals.kinds).filter(k => k.last)) { %>
        <div class="toggle-row"><div><b><%= k.name %></b><small><%= k.status.note %> · <%= k.trend.dir %></small></div><span><b><%= fmt(k.last) %></b> <span class="muted small"><%= k.unit %></span></span></div><% } %>
        <% if (adherence && adherence.pct != null) { %><div class="toggle-row"><div><b>Medicine adherence</b><small>Last 7 days</small></div><b><%= adherence.pct %>%</b></div><% } %>
      <% } %></section>
  </div>
</div>
<%- include('../partials/bottom') %>
