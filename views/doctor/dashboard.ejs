<%- include('../partials/top') %>
<section class="hero teal med">
  <div><h1>Welcome back, <%= user.full_name.replace(/^Dr\.\s*/, 'Dr. ').split(' ').slice(0, 2).join(' ') %></h1>
    <p>You have <%= todayTotal %> appointment<%= todayTotal === 1 ? '' : 's' %> today and <%= requests.length %> request<%= requests.length === 1 ? '' : 's' %> waiting for a proposed time.</p>
    <div class="actions"><a class="btn white" href="/doctor/requests">Review requests</a><a class="btn glass" href="/doctor/schedule">Open schedule</a></div></div>
  <div class="hero-side"><small>Next consultation</small>
    <% if (next) { %><b><%= next.patient_name %></b><div><%= friendly(next.proposed_time) %><%= nextTests.length ? ' · Awaiting ' + nextTests[0].toLowerCase() : '' %></div><% } else { %><b>None booked</b><div>Propose times to pending requests.</div><% } %></div>
  <%- include('../partials/stickers', { set: 'doctor' }) %>
</section>
<div class="share-bar mt" data-share-location="<%= me.share_location ? 1 : 0 %>">
  <span class="tile <%= me.share_location ? 't-red' : 't-blue' %>"><%- icon('nav', 20) %></span>
  <div class="grow"><b><%= me.share_location ? 'Live location is ON' : 'Share your live location' %></b><div class="muted small"><%= me.share_location ? 'Patients see how far you are while this page is open. Your fee: ' + money(me.fee) : 'Patients will see your distance from them when they book.' %></div></div>
  <form method="post" action="/doctor/location-sharing"><%- include('../partials/csrf') %><input type="hidden" name="on" value="<%= me.share_location ? 0 : 1 %>"><button class="btn sm <%= me.share_location ? 'danger' : '' %>"><%= me.share_location ? 'Turn off' : 'Turn on' %></button></form>
</div>
<% if (chatRequests.length) { %><section class="card mt"><div class="card-h"><h2><%- icon('message', 20) %> Chat requests</h2><a href="/messages">All chats</a></div>
  <% for (const t of chatRequests) { %><div class="item"><%- avatar(t.patient_name, 'md', t.patient_id) %><div class="grow"><b><%= t.patient_name %></b><div class="meta"><%= t.topic || 'Wants to message you' %></div></div>
    <form method="post" action="/messages/<%= t.id %>/accept"><%- include('../partials/csrf') %><button class="btn green sm">Accept</button></form>
    <form method="post" action="/messages/<%= t.id %>/decline"><%- include('../partials/csrf') %><button class="btn danger sm">Decline</button></form></div><% } %></section><% } %>
<div class="grid g4 mt"><% for (const s of cards) { %><%- include('../partials/stat', { s }) %><% } %></div>
<div class="grid g-main mt">
  <section class="card"><div class="card-h"><h2>Consultations</h2><%- pill('Last 6 months') %></div><%- areaChart(chart.values, chart.labels, { label: 'Completed consultations per month' }) %></section>
  <section class="card"><h2>Appointment status</h2><div class="mt"><%- donut(ring, todayTotal, 'Today') %></div>
    <div class="chips mt" style="justify-content:center"><%- pill('Confirmed') %><%- pill('Pending', 'amber') %><%- pill('Done', 'green') %></div></section>
</div>
<div class="grid g-main mt">
  <section class="card"><div class="card-h"><h2>New appointment requests</h2><a href="/doctor/requests" style="text-decoration:underline;font-weight:600">View all</a></div>
    <% if (!requests.length) { %><div class="empty small">No new requests.</div><% } %>
    <% for (const r of requests.slice(0, 4)) { %>
      <div class="item"><div class="grow"><b style="font-size:16px"><%= r.patient_name %></b><div class="meta"><%= (r.reason || '').slice(0, 50) %></div></div>
        <% if (r.status === 'requested' && r.preferred_time && /^\d{4}-\d{2}-\d{2}T/.test(r.preferred_time)) { %>
          <span class="small muted"><%= friendly(r.preferred_time) %></span>
          <form method="post" action="/doctor/appointments/<%= r.id %>/accept-preferred"><%- include('../partials/csrf') %><button class="btn green sm">Approve</button></form>
          <form method="post" action="/doctor/appointments/<%= r.id %>/decline" data-confirm="Delete this booking?"><%- include('../partials/csrf') %><button class="btn danger sm">Delete</button></form>
        <% } else { %><a class="btn sm" href="/doctor/requests?id=<%= r.id %>"><%= r.status === 'reschedule_requested' ? 'Review' : 'Propose time' %></a><%- r.status === 'reschedule_requested' ? pill('Reschedule') : pill('New', 'amber') %><% } %></div>
    <% } %>
  </section>
  <section class="card"><h2 style="margin-bottom:16px">Today's schedule</h2>
    <% if (!today.length) { %><div class="empty small">No consultations today.</div><% } %>
    <div class="timeline"><% for (const a of today) { %><div class="tl"><span class="dot <%= a.status === 'completed' ? 'green' : new Date(a.proposed_time) < new Date() ? 'orange' : 'blue' %>"></span>
      <b><a href="/doctor/appointments/<%= a.id %>" style="color:inherit"><%= fmtTime(a.proposed_time) %> · <%= a.patient_name %></a></b><span><%= (a.reason || '').slice(0, 40) %><%= a.status === 'completed' ? ' · Done' : '' %></span></div><% } %></div>
  </section>
</div>
<%- include('../partials/bottom') %>
