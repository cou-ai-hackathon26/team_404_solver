<%- include('../partials/auth-top', { wide: true }) %>
<div class="auth-card wide">
  <span class="steps-mini"><span class="on">1 Your details</span><span>2 Verify email</span><span>3 Log in</span></span>
  <h1>Create your patient account</h1>
  <p class="sub">Doctors, centers and pharmacies register through <a href="/register/provider">provider registration</a>.</p>
  <form method="post" action="/register">
    <%- include('../partials/csrf') %>
    <div class="fgrid">
      <label class="f">Full name<input name="full_name" value="<%= form.full_name || '' %>" required autocomplete="name"></label>
      <label class="f">Phone number<input name="phone" value="<%= form.phone || '' %>" required placeholder="01XXXXXXXXX" autocomplete="tel"></label>
      <label class="f">Email address<input type="email" name="email" value="<%= form.email || '' %>" required autocomplete="email"></label>
      <label class="f">Date of birth<input type="date" name="date_of_birth" value="<%= form.date_of_birth || '' %>" required></label>
      <label class="f">Password<input type="password" name="password" required minlength="8" autocomplete="new-password"><small>8+ characters with a letter and a number</small></label>
      <label class="f">Confirm password<input type="password" name="confirm_password" required minlength="8" autocomplete="new-password"></label>
      <label class="f full">Address or area<input name="address" value="<%= form.address || '' %>" placeholder="House, road, area"></label>
    </div>
    <label class="check" style="margin-bottom:18px"><input type="checkbox" name="accept_terms" value="1" <%= form.accept_terms ? 'checked' : '' %>> I agree to the Terms and Privacy Policy.</label>
    <button class="btn block lg">Create account and send code</button>
  </form>
  <p class="muted" style="text-align:center;margin-top:16px">Already registered? <a href="/login" style="text-decoration:underline;font-weight:600">Log in</a></p>
</div>
<%- include('../partials/auth-bottom') %>
