<%- include('../partials/auth-top', { wide: true, artTitle: 'Join the MediConnect care network.', artText: 'Verified doctors, diagnostic centers and pharmacies reach patients who need them. Every account is checked by an administrator.', artFeatures: [['shield','Verified accounts only','Admins review your license before activation'],['users','Patients find you','AI recommendations show verified providers'],['file','Paperless workflow','Requests, reports and orders in one portal']] }) %>
<div class="auth-card wide">
  <span class="steps-mini"><span class="on">1 Details & documents</span><span>2 Verify email</span><span>3 Admin review</span></span>
  <h1>Register as a provider</h1>
  <p class="sub">Your portal opens after an administrator checks your documents.</p>
  <form method="post" action="/register/provider?_csrf=<%= csrf %>" enctype="multipart/form-data">
    <label class="f">I am registering a
      <select name="role">
        <% for (const [v, t] of [['doctor','Doctor'],['center','Diagnostic center'],['pharmacy','Pharmacy / medical shop']]) { %><option value="<%= v %>" <%= form.role === v ? 'selected' : '' %>><%= t %></option><% } %>
      </select>
    </label>
    <div class="fgrid">
      <label class="f">Full name (doctor or contact person)<input name="full_name" value="<%= form.full_name || '' %>" required></label>
      <label class="f">Phone number<input name="phone" value="<%= form.phone || '' %>" required></label>
      <label class="f">Email address<input type="email" name="email" value="<%= form.email || '' %>" required></label>
      <label class="f">License / registration no.<input name="license_no" value="<%= form.license_no || '' %>" required placeholder="BMDC, trade or drug license"></label>
      <label class="f">Password<input type="password" name="password" required minlength="8"></label>
      <label class="f">Confirm password<input type="password" name="confirm_password" required minlength="8"></label>
    </div>
    <fieldset style="border:1px solid var(--line);border-radius:16px;padding:16px 16px 4px;margin:0 0 16px">
      <legend class="small" style="font-weight:700;padding:0 6px">Doctors</legend>
      <div class="fgrid">
        <label class="f">Specialty<select name="specialty"><option value="">Choose…</option><% for (const s of specialties) { %><option <%= form.specialty === s ? 'selected' : '' %>><%= s %></option><% } %></select></label>
        <label class="f">Qualifications<input name="qualifications" value="<%= form.qualifications || '' %>" placeholder="MBBS, FCPS"></label>
        <label class="f">Years of experience<input type="number" min="0" name="experience_years" value="<%= form.experience_years || '' %>"></label>
        <label class="f">Consultation fee (BDT)<input type="number" min="0" name="fee" value="<%= form.fee || '' %>"></label>
      </div>
    </fieldset>
    <fieldset style="border:1px solid var(--line);border-radius:16px;padding:16px 16px 4px;margin:0 0 16px">
      <legend class="small" style="font-weight:700;padding:0 6px">Centers and pharmacies</legend>
      <div class="fgrid">
        <label class="f">Organization name<input name="org_name" value="<%= form.org_name || '' %>"></label>
        <label class="f">Address<input name="org_address" value="<%= form.org_address || '' %>"></label>
      </div>
    </fieldset>
    <div class="fgrid">
      <label class="f">License document <small>(required)</small><input type="file" name="license" accept="application/pdf,image/*" required></label>
      <label class="f">Degree certificate <small>(doctors)</small><input type="file" name="degree" accept="application/pdf,image/*"></label>
      <label class="f">National ID <small>(optional)</small><input type="file" name="nid" accept="application/pdf,image/*"></label>
    </div>
    <label class="check" style="margin:4px 0 18px"><input type="checkbox" name="accept_terms" value="1"> I confirm these details are correct and agree to the Terms.</label>
    <button class="btn block lg">Submit and send code</button>
  </form>
  <p class="muted" style="text-align:center;margin-top:16px">Already registered? <a href="/login">Log in</a></p>
</div>
<%- include('../partials/auth-bottom') %>
