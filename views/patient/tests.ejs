<%- include('../partials/top') %>
<a class="promo-bar" href="/patient/tests/compare"><span class="tile t-orange"><%- icon('search', 20) %></span><div class="grow"><b>Have several tests? Search them all at once</b><div class="muted small">Find the nearest center with every test, the lowest total and the biggest discount.</div></div><span class="btn sm">Compare centers</span></a>
<div class="page-h"><div><h1>Medical tests and reports</h1><p>Tests prescribed by your doctor appear here automatically.</p></div></div>
<div class="grid g3"><% for (const s of cards) { %><%- include('../partials/stat', { s }) %><% } %></div>
<div class="grid g-main-r mt">
  <section class="card" id="prescribed"><h2 style="margin-bottom:14px">Prescribed tests</h2>
    <% if (!tests.length) { %><div class="empty small">No tests prescribed yet.</div><% } %>
    <% for (const t of tests.slice(0, 8)) { %>
      <div class="item <%= sel && sel.id === t.id ? 'sel' : '' %>"><div class="grow"><b><%= t.name %></b><div class="meta"><%= t.doctor_name || 'Walk-in' %> · <%= shortDate(t.created_at) %><%= t.center_name ? ' · ' + t.center_name : '' %><%= t.scheduled_at ? ' · ' + friendly(t.scheduled_at) : '' %></div></div>
        <% if (t.report_id) { %><a class="btn ghost sm" href="/files/report/<%= t.report_id %>" target="_blank">View</a><%- pill('Report ready', 'green') %>
        <% } else if (t.status === 'prescribed') { %><a class="btn ghost sm" href="?test=<%= t.id %>">Book</a><%- pill('Pending', 'amber') %>
        <% } else { %><%- badge(t.status) %><% if (['requested','scheduled'].includes(t.status)) { %><form method="post" action="/patient/tests/<%= t.id %>/cancel" data-confirm="Cancel this booking?"><%- include('../partials/csrf') %><button class="link small">Cancel</button></form><% } %><% } %></div>
    <% } %>
  </section>
  <section class="card">
    <div class="card-h"><h2>Nearby diagnostic centers</h2><%- pill(sel ? sel.name : 'Within 5 km') %></div>
    <% if (!sel) { %><div class="empty small">Nothing to book. Prescribed tests that need a center appear here.</div><% } else if (!centers.length) { %><div class="empty small">No verified center offers this test yet.</div><% } %>
    <% if (sel && profile.lat == null) { %><p class="muted small" style="margin-bottom:10px">Add your location in <a href="/patient/profile">Profile</a> to sort centers by distance.</p><% } %>
    <% centers.forEach((c, i) => { %>
      <form class="item" method="post" action="/patient/tests/<%= sel.id %>/book"><%- include('../partials/csrf') %><input type="hidden" name="center_id" value="<%= c.id %>">
        <span class="tile <%= ['t-blue','t-pink','t-teal','t-orange'][i % 4] %>"><%- icon('flask', 22) %></span>
        <div class="grow"><b><%= c.name %></b><div class="meta"><%= c.distance != null ? c.distance + ' km · ' : '' %><%= c.opening_hours %></div><div class="meta"><%= c.tests.join(', ') %></div></div>
        <div style="text-align:right"><b><%= money(c.price) %></b><div class="meta"><%= c.report_time %></div><input type="date" name="preferred_date" min="<%= todayInput() %>" style="margin:6px 0;padding:6px 8px;font-size:13px" aria-label="Preferred date"><button class="btn sm"<%= c.online_booking ? '' : ' disabled' %>>Book test</button></div>
      </form>
    <% }) %>
  </section>
</div>
<div class="grid g2 mt">
  <section class="card warm">
    <% if (request) { %>
      <div class="row nowrap"><span class="tile t-orange"><%- icon('shield', 22) %></span><h2>Access request</h2></div>
      <p class="mt"><b><%= request.doctor_name %></b> wants to view your <%= request.test_name ? request.test_name + ' report' : 'reports' %> for <%= request.duration_hours >= 48 ? Math.round(request.duration_hours / 24) + ' days' : request.duration_hours + ' hours' %>.</p>
      <div class="grid g2 mt" style="gap:12px">
        <form method="post" action="/patient/access/<%= request.id %>/approve"><%- include('../partials/csrf') %><button class="btn block">Approve</button></form>
        <form method="post" action="/patient/access/<%= request.id %>/reject"><%- include('../partials/csrf') %><button class="btn ghost block">Reject</button></form>
      </div>
      <p class="muted small mt-s">You can also <a href="/patient/records#share">share only selected reports</a> instead of your full history.</p>
    <% } else { %>
      <div class="row nowrap"><span class="tile t-orange"><%- icon('shield', 22) %></span><h2>No access requests</h2></div>
      <p class="muted mt-s">When a doctor asks to see your reports, you decide here. You can also share selected reports from <a href="/patient/records">Medical records</a>.</p>
    <% } %>
  </section>
  <section class="card"><h2 style="margin-bottom:14px">Audit log</h2>
    <% if (!log.length) { %><div class="empty small">No access to your records yet.</div><% } %>
    <div class="timeline"><% for (const l of log) { %><div class="tl"><span class="dot <%= l.color %>"></span><b style="font-size:15px"><%= l.text %></b><span class="small"><%= fmtDateTime(l.created_at) %></span></div><% } %></div>
  </section>
</div>
<%- include('../partials/bottom') %>
