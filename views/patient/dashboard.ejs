<%- include('../partials/top') %>
<section class="hero med">
  <div>
    <span class="chip">Patient ID <%= profile.patient_code || '—' %></span>
    <h1><%= greeting %>, <%= user.full_name.split(' ')[0] %></h1>
    <p><%= summary %></p>
    <div class="actions"><a class="btn white" href="/patient/find-doctor">Find a doctor with AI</a><a class="btn glass" href="/patient/records">View report</a></div>
  </div>
  <div class="hero-side">
    <% if (next) { %>
      <small>Next appointment</small><b><%= next.doctor_name %></b>
      <div><%= next.specialty %> · <%= friendly(next.proposed_time) %></div>
      <div class="mt-s"><%- badge('confirmed') %></div>
    <% } else { %>
      <small>Next appointment</small><b>Nothing booked</b><div>Find a doctor and request a time.</div>
    <% } %>
  </div>
  <%- include('../partials/stickers', { set: 'patient' }) %>
</section>

<div class="quick mt">
  <% [['/patient/find-doctor', 'stethoscope', 't-teal', 'Find doctor', 'AI · বাংলা/English'], ['/emergency', 'ambulance', 't-red', 'Ambulance', 'Live nearby'], ['/patient/shop', 'cart', 't-purple', 'Medicine shop', 'Best price'],
      ['/patient/tests/compare', 'flask', 't-orange', 'Compare tests', 'Price & discount'], ['/patient/assistant', 'bot', 't-blue', 'Health AI', 'First-aid advice'], ['/patient/analysis', 'trend', 't-teal', 'Health analysis', 'Charts & prediction'],
      ['/blood', 'drop', 't-red', 'Blood bank', 'Find donors'], ['/messages', 'message', 't-blue', 'Doctor chat', 'Ask your doctor']].forEach(([href, ic, tile, t, sub], i) => { %>
    <a href="<%= href %>" style="--d:<%= i * 50 %>ms"><span class="tile <%= tile %>"><%- icon(ic, 24) %></span><%= t %><small><%= sub %></small></a>
  <% }) %>
</div>

<div class="grid g4 mt"><% for (const s of cards) { %><%- include('../partials/stat', { s }) %><% } %></div>

<div class="grid g-main mt">
  <section class="card">
    <div class="card-h"><h2>Your care journey</h2><%- pill('This month') %></div>
    <% if (!journey.length) { %><div class="empty">Your consultations, tests, reports and orders will appear here.</div><% } %>
    <div class="timeline">
      <% const J = { consult: ['blue', (j) => `Consultation with ${j.who}`, (j) => `${shortDate(j.t)} · ${String(j.what || '').slice(0, 60)}`],
                     tests: ['orange', () => 'Tests prescribed', (j) => j.what],
                     report: ['green', (j) => `${j.what} report uploaded`, (j) => `${shortDate(j.t)} · ${j.who} · You were notified`],
                     order: ['purple', () => 'Medicines ordered', (j) => `${j.who} · ${label(j.what)}`] }; %>
      <% for (const j of journey) { const k = J[j.k]; %>
        <div class="tl"><span class="dot <%= k[0] %>"></span><b><%= k[1](j) %></b><span><%= k[2](j) %></span></div>
      <% } %>
    </div>
  </section>
  <section class="card soft">
    <h2>AI Doctor Match</h2>
    <p class="muted mt-s">Describe your symptoms and get matched with verified specialists.</p>
    <% if (lastResult && lastResult.terms && lastResult.terms.length) { %>
      <div class="chips mt-s"><% for (const t of lastResult.terms.slice(0, 3)) { %><span class="chip" style="font-size:13px;padding:4px 12px"><%= t.replace(' (history)', '') %></span><% } %></div>
      <div class="item mt-s" style="background:#fff"><div><span class="muted small">Suggested specialty</span><div style="font-size:22px;font-weight:800;color:var(--ink)"><%= lastResult.specialties[0].specialty %></div></div></div>
      <a class="btn block mt-s" href="/patient/find-doctor?entry=<%= lastEntry.id %>">See matched doctors</a>
    <% } else { %>
      <form method="post" action="/patient/find-doctor" class="mt-s"><%- include('../partials/csrf') %>
        <textarea name="description" placeholder="e.g. Chest tightness when climbing stairs for 3 days" style="min-height:90px;background:#fff"></textarea>
        <button class="btn block mt-s">Analyze with AI</button></form>
    <% } %>
    <p class="muted small mt-s">Decision support only. It does not replace a doctor.</p>
  </section>
</div>

<div class="grid g-main mt">
  <section class="card">
    <h2 style="margin-bottom:16px">Quick actions</h2>
    <div class="qa">
      <a class="q-blue" href="/patient/find-doctor"><%- icon('calendar', 28) %>Book appointment</a>
      <a class="q-orange" href="/patient/tests"><%- icon('flask', 28) %>Medical tests</a>
      <a class="q-teal" href="/patient/records"><%- icon('file', 28) %>My reports</a>
      <a class="q-purple" href="/patient/order"><%- icon('upload', 28) %>Upload prescription</a>
      <a class="q-pink" href="/patient/order"><%- icon('pill', 28) %>Order medicine</a>
      <a class="q-dark" href="/patient/records#share"><%- icon('shield', 28) %>Share records</a>
    </div>
  </section>
  <div class="stack">
    <section class="card">
      <h2 style="margin-bottom:16px">Access requests</h2>
      <% if (!requests.length) { %><div class="empty small">No doctor is waiting for access.</div><% } else { const r = requests[0]; %>
        <div class="item"><div class="grow"><b><%= r.doctor_name %></b><div class="meta">Wants your <%= r.test_name ? r.test_name + ' report' : 'reports' %> · <%= r.duration_hours >= 48 ? Math.round(r.duration_hours / 24) + ' days' : r.duration_hours + ' hours' %></div></div><%- badge('pending') %></div>
        <div class="grid g2 mt-s" style="gap:12px">
          <form method="post" action="/patient/access/<%= r.id %>/approve"><%- include('../partials/csrf') %><button class="btn block">Approve</button></form>
          <form method="post" action="/patient/access/<%= r.id %>/reject"><%- include('../partials/csrf') %><button class="btn ghost block">Reject</button></form>
        </div>
      <% } %>
      <div class="note mt-s"><%- icon('shield', 18) %> Every access to your records is logged.</div>
    </section>
    <% const due = doses.filter(d => d.status === 'due'); if (doses.length) { %>
    <section class="card">
      <div class="card-h"><h2>Today's medicines</h2><a href="/patient/reminders" class="small">All reminders</a></div>
      <% for (const d of doses.slice(0, 4)) { %>
        <div class="item"><span class="tile sm t-purple"><%- icon('alarm', 18) %></span><div class="grow"><b><%= d.medicine_name %></b><div class="meta"><%= fmtTime(d.due_at) %> · <%= d.dose %></div></div>
          <% if (d.status === 'due') { %><form method="post" action="/patient/reminders/dose/<%= d.id %>/taken"><%- include('../partials/csrf') %><button class="btn sm">Taken</button></form><% } else { %><%- badge(d.status) %><% } %></div>
      <% } %>
    </section>
    <% } %>
  </div>
</div>
<%- include('../partials/bottom') %>
