<%- include('../partials/top') %>
<div class="page-h"><div class="row nowrap"><span class="bot-avatar"><%- icon('bot', 30) %></span><div><h1>Health AI</h1><p>Ask any health question in Bangla or English: what to do first for a headache, fever, gastric, a cut or a sprain, and when to see a doctor.</p></div></div>
  <div class="row"><%- pill(ai ? 'Powered by Claude' : 'Built-in answers', ai ? 'purple' : 'blue') %><form method="post" action="/patient/assistant/clear"><%- include('../partials/csrf') %><button class="btn ghost sm">Clear chat</button></form></div></div>
<div class="grid g-main">
  <section class="card">
    <div class="chat">
      <div class="msg assistant">আসসালামু আলাইকুম <%= user.full_name.split(' ')[0] %>! আমি আপনার Health AI। আপনার কী সমস্যা লিখুন — প্রথমে কী করবেন আর কখন ডাক্তার দেখাবেন জানিয়ে দেব।
Hello! Tell me what you feel and I will give first-aid advice. In an emergency call 999.</div>
      <% for (const m of messages) { %><div class="msg <%= m.role %> <%= m.flagged ? 'flag' : '' %>"><%= m.body %></div><% } %>
      <span id="end"></span>
    </div>
    <form method="post" action="/patient/assistant" class="row nowrap mt" data-chat-form><%- include('../partials/csrf') %>
      <input name="message" placeholder="যেমন: মাথা ব্যথা, কী করব? / I have a fever…" required autocomplete="off" style="margin:0"><button class="btn"><%- icon('send', 16) %>Send</button></form>
  </section>
  <div class="stack">
    <section class="card soft"><h2 style="margin-bottom:12px">Try asking</h2>
      <% for (const s of ['আমার মাথা ব্যথা, প্রাথমিকভাবে কী করতে পারি?', 'গতকাল থেকে জ্বর, কী করব?', 'I have acidity after meals', 'হাত মচকে গেছে, কী করব?', 'How can I sleep better?', 'Healthy diet tips', "What medicines do I take today?", 'When is my next appointment?']) { %>
        <button type="button" class="item" data-suggest="<%= s %>" style="width:100%;text-align:left;cursor:pointer;font:inherit;background:#fff"><%- icon('sparkles', 16) %><span><%= s %></span></button><% } %></section>
    <section class="card"><h2 style="margin-bottom:10px">Safety</h2>
      <div class="note"><%- icon('shield', 18) %> Emergency words (chest pain, can’t breathe, unconscious…) always get the 999 advice first.</div>
      <p class="muted small mt-s">The assistant reads only your own records, and only to answer your question.</p></section>
  </div>
</div>
<%- include('../partials/bottom') %>
