<% if (user && user.status === 'active') { %><%- include('../partials/top') %><% } else { %><%- include('../partials/head') %><body><main class="content" style="margin:60px auto"><% } %>
<div class="card" style="max-width:560px;margin:40px auto;text-align:center">
  <span class="tile t-blue" style="margin:0 auto 14px"><%- icon('shield', 24) %></span>
  <h1 style="font-size:26px"><%= title %></h1>
  <p class="muted mt-s"><%= message %></p>
  <p class="mt"><a class="btn" href="<%= user ? dashboard : '/login' %>">Go to <%= user ? 'your dashboard' : 'log in' %></a></p>
</div>
<% if (user && user.status === 'active') { %><%- include('../partials/bottom') %><% } else { %></main></body></html><% } %>
