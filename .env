# MediConnect settings

PORT=3000
NODE_ENV=development

# Long random string used to sign sessions and hash OTP codes.
SESSION_SECRET=b8c6135226ae8e8018a79355de84e6f7757fa7ac15d17c97a78a2c5834ef8a1c

# Session idle timeout in minutes (rolling).
SESSION_TIMEOUT_MINUTES=30

# ---- Email (OTP delivery) ----
# Verification codes for patients, doctors and diagnostic centers are emailed to the address they register with.
# Gmail needs 2-Step Verification and a 16-letter App Password (myaccount.google.com/apppasswords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=jahid241-15-759@diu.edu.bd
SMTP_PASS=ubjljtvjfoxvvfbp

MAIL_FROM="MediConnect <jahid241-15-759@diu.edu.bd>"

# ---- SMS (phone verification for medical shops and ambulances) ----
# console = print the code in the terminal. bulksmsbd = bulksmsbd.net (Bangladesh). twilio = Twilio.
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Show the OTP on the verification page too (development only). false = codes go only by email.
DEV_SHOW_OTP=false

# ---- OTP and login policy ----
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Default number of hours a doctor's approved access to records lasts.
ACCESS_GRANT_HOURS=48

# Database file (SQLite, created automatically)
DB_FILE=data/mediconnect.db

# Time zone used for schedules, slots and reminders.
TZ=Asia/Dhaka

# ---- Health Assistant chatbot (optional) ----
# With a key, the assistant uses Claude to write answers from your own records.
# Without a key it still works, using built-in rule-based answers.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5